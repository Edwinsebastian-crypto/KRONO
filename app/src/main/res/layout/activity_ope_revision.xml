<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krono_bg"
    tools:context=".OperarioActivity">

    <!-- Status Bar Navy Background Header -->
    <View
        android:id="@+id/statusBarBg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:background="@color/krono_navy" />

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@id/statusBarBg"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/krono_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REV."
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtOperarioSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operario de Granja • Revisiones"
                android:textColor="@color/krono_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Cerrar Sesión -->
        <FrameLayout
            android:id="@+id/btnBackLogin"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_container"
            android:clickable="true"
            android:contentDescription="Cerrar sesión"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Cerrar sesión"
                android:src="@drawable/ic_logout"
                app:tint="@color/krono_navy" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar (Tabs: Hoja Pedido / Revisiones) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Tab 1: Hoja Pedido (Inactivo) -->
        <LinearLayout
            android:id="@+id/tabPedido"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Hoja Pedido"
                android:src="@drawable/ic_description"
                app:tint="@color/krono_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hoja Pedido"
                android:textColor="@color/krono_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 2: Revisiones (Activo) -->
        <LinearLayout
            android:id="@+id/tabRevisiones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Revisiones"
                android:src="@drawable/ic_fact_check"
                app:tint="@color/krono_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Revisiones"
                android:textColor="@color/krono_navy"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Contenido Scrollable de Revisiones -->
    <ScrollView
        android:id="@+id/scrollViewRevisiones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentRevisiones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- Título de Sección -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hojas de Pedidos Enviadas"
                android:textColor="@color/krono_navy_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Toque un pedido para abrir su detalle completo y dictamen del supervisor"
                android:textColor="@color/krono_text_secondary"
                android:textSize="12sp" />

            <!-- Contenedor dinámico de revisiones con estilo de Imagen 2 -->
            <LinearLayout
                android:id="@+id/containerRevisiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
