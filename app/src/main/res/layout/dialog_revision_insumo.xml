<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pin_box"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Dictamen de Insumo"
            android:textColor="@color/krono_navy_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCerrarModal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:src="@drawable/ic_close"
            app:tint="@color/krono_text_secondary" />
    </RelativeLayout>

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/txtModalProductoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Fertilizante NPK 15-15-15 (Sacos 50kg)"
        android:textColor="@color/krono_navy"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtModalCantidadOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Cantidad solicitada en campo: 20 sacos"
        android:textColor="@color/krono_text_secondary"
        android:textSize="12sp" />

    <!-- Selección de Dictamen (Aprobar, Ajustar, Rechazar) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Selecciona el Dictamen:"
        android:textColor="@color/krono_navy_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Opción Aprobar -->
        <TextView
            android:id="@+id/btnDictamenAprobar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_green_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✓ Aprobar"
            android:textColor="@color/krono_green_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Opción Ajustar -->
        <TextView
            android:id="@+id/btnDictamenAjustar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✏️ Ajustar"
            android:textColor="@color/krono_chip_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Opción Rechazar -->
        <TextView
            android:id="@+id/btnDictamenRechazar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_red_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✗ Rechazar"
            android:textColor="@color/krono_red_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Campo: Cantidad Aprobada/Ajustada -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Cantidad Aprobada / Ajustada:"
        android:textColor="@color/krono_navy_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModalCantidadAjustada"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pin_box"
        android:hint="Ej: 18 sacos"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/krono_navy_dark"
        android:textColorHint="@color/krono_text_muted"
        android:textSize="13sp" />

    <!-- Campo: Observaciones del Supervisor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Observación / Motivo (Opcional):"
        android:textColor="@color/krono_navy_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModalObservacionInsumo"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pin_box"
        android:gravity="top|start"
        android:hint="Ej: Se reduce cantidad por disponibilidad de stock..."
        android:inputType="textMultiLine|textCapSentences"
        android:padding="10dp"
        android:textColor="@color/krono_navy_dark"
        android:textColorHint="@color/krono_text_muted"
        android:textSize="12sp" />

    <!-- Botones de Acción del Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModalCancelar"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/white"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/krono_card_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModalGuardarDictamen"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/krono_navy"
            android:text="Guardar Dictamen"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
