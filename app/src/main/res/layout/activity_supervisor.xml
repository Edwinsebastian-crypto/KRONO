<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krono_bg"
    tools:context=".SupervisorActivity">

    <!-- Status Bar Navy Background Header -->
    <View
        android:id="@+id/statusBarBg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:background="@color/krono_navy" />

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@id/statusBarBg"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Krono Rev"
                android:src="@drawable/ic_inventory"
                app:tint="@color/krono_navy" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/krono_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REV."
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supervisor Operativo"
                android:textColor="@color/krono_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- User Avatar Logo -->
        <ImageView
            android:id="@+id/btnBackLogin"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Avatar"
            android:focusable="true"
            android:src="@drawable/logo" />
    </LinearLayout>

    <!-- Bottom Navigation Bar (4 Tabs) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Tab 1: Zonas y Granjas (Active) -->
        <LinearLayout
            android:id="@+id/tabZonas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Zonas y Granjas"
                android:src="@drawable/ic_target"
                app:tint="@color/krono_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zonas y Granjas"
                android:textColor="@color/krono_navy"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Hoja Pedido -->
        <LinearLayout
            android:id="@+id/tabHojaPedido"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Hoja Pedido"
                android:src="@drawable/ic_description"
                app:tint="@color/krono_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoja Pedido"
                android:textColor="@color/krono_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Pedidos -->
        <LinearLayout
            android:id="@+id/tabPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Pedidos"
                android:src="@drawable/ic_truck"
                app:tint="@color/krono_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedidos"
                android:textColor="@color/krono_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 4: Historial -->
        <LinearLayout
            android:id="@+id/tabHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Historial"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/krono_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/krono_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollViewSupervisor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Review & Approval Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="• Periodo Activo"
                            android:textColor="@color/krono_navy_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Corte: 31 Oct - 18:00"
                            android:textColor="@color/krono_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Revisión y Aprobación de Ciclo Mensual"
                        android:textColor="@color/krono_navy_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Supervisión de pedidos consolidados para insumos y fertilizantes • Octubre 2024"
                        android:textColor="@color/krono_text_secondary"
                        android:textSize="12sp" />

                    <!-- Grid Counter Box (3 cards) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Counter 1: En Zona -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cierre_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/txtCountEnZona"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="En Zona"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Counter 2: Listas -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cierre_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/txtCountListas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Listas ✓"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Counter 3: Pendiente -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cierre_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/txtCountPendiente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Pendiente"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Select Zone Selector -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Location"
                                android:src="@drawable/ic_location"
                                app:tint="@color/krono_navy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Seleccionar Zona Operativa"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="4 Regiones"
                            android:textColor="@color/krono_text_secondary"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Dropdown Select Box -->
                    <RelativeLayout
                        android:id="@+id/btnZoneDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_cierre_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameLocIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_button_primary">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Location"
                                android:src="@drawable/ic_location"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/frameLocIcon"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtSelectedZoneTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zona Norte (Valle Agrícola)"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSelectedZoneSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8 Granjas asignadas • 3 listas"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Dropdown"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/krono_navy" />
                    </RelativeLayout>

                    <!-- Filter Chips Carousel -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Chip 1: Zona Norte (Active) -->
                            <TextView
                                android:id="@+id/chipZoneNorte"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_primary"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="• Zona Norte (Activo)"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <!-- Chip 2: Zona Valle Central -->
                            <TextView
                                android:id="@+id/chipZoneValle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Valle Central"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />

                            <!-- Chip 3: Zona Sur -->
                            <TextView
                                android:id="@+id/chipZoneSur"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Sur"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />

                            <!-- Chip 4: Zona Occidente -->
                            <TextView
                                android:id="@+id/chipZoneOccidente"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Occidente"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Granjas Registradas Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Farm List"
                        android:src="@drawable/ic_farm"
                        app:tint="@color/krono_navy" />

                    <TextView
                        android:id="@+id/txtHeaderGranjas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Granjas Registradas en Zona Norte"
                        android:textColor="@color/krono_navy_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCountVisibles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="6 visibles"
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Farm Item 1: Granja Los Laureles -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <FrameLayout
                        android:id="@+id/frameFarm1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_container">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Tractor"
                            android:src="@drawable/ic_tractor"
                            app:tint="@color/krono_navy" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/frameFarm1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Granja Los Laureles"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="Check"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/krono_navy" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sector El Trébol • Parcela 4"
                            android:textColor="@color/krono_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_blue_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="✓ Hoja Lista (3)"
                        android:textColor="@color/krono_navy_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Farm Item 2: Finca San Isidro -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:id="@+id/frameFarm2"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/bg_icon_container">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="Tractor"
                                android:src="@drawable/ic_tractor"
                                app:tint="@color/krono_navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/frameFarm2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Finca San Isidro"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Por Mateo Rosales • 10:15 AM"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_blue_chip"
                            android:paddingHorizontal="10dp"
