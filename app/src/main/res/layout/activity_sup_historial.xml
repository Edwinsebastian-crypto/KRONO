<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krono_bg"
    tools:context=".SupervisorActivity">

    <!-- Status Bar Navy Background Header -->
    <View
        android:id="@+id/statusBarBg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:background="@color/krono_navy" />

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@id/statusBarBg"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/krono_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REV."
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supervisor Operativo • Historial"
                android:textColor="@color/krono_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Cerrar Sesión -->
        <FrameLayout
            android:id="@+id/btnBackLogin"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_container"
            android:clickable="true"
            android:contentDescription="Cerrar sesión"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Cerrar sesión"
                android:src="@drawable/ic_logout"
                app:tint="@color/krono_navy" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar (2 Tabs: Zonas y Granjas / Historial) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Tab 1: Zonas y Granjas -->
        <LinearLayout
            android:id="@+id/tabZonas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Zonas y Granjas"
                android:src="@drawable/ic_target"
                app:tint="@color/krono_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Zonas y Granjas"
                android:textColor="@color/krono_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 2: Historial (Active) -->
        <LinearLayout
            android:id="@+id/tabHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Historial"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/krono_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Historial"
                android:textColor="@color/krono_navy"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollViewHistorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Seleccionar Zona Operativa (Copia fiel de Zonas y Granjas) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectZoneHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Location"
                                android:src="@drawable/ic_location"
                                app:tint="@color/krono_navy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Seleccionar Zona Operativa"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtCountRegionesHistorial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="4 Regiones"
                            android:textColor="@color/krono_text_secondary"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <!-- Dropdown Select Box -->
                    <RelativeLayout
                        android:id="@+id/btnZoneDropdownHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_cierre_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameLocIconHistorial"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_button_primary">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Location"
                                android:src="@drawable/ic_location"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/frameLocIconHistorial"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtSelectedZoneTitleHistorial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zona Norte (Valle Agrícola)"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSelectedZoneSubHistorial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8 Granjas asignadas • 3 listas"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Dropdown"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/krono_navy" />
                    </RelativeLayout>

                    <!-- Filter Chips Carousel -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Chip 1: Zona Norte -->
                            <TextView
                                android:id="@+id/chipHistorialNorte"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_primary"
                                android:gravity="center"
                                android:paddingHorizontal="14dp"
                                android:text="• Zona Norte (Activo)"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <!-- Chip 2: Zona Valle Central -->
                            <TextView
                                android:id="@+id/chipHistorialValle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Valle Central"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />

                            <!-- Chip 3: Zona Sur -->
                            <TextView
                                android:id="@+id/chipHistorialSur"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Sur"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />

                            <!-- Chip 4: Zona Occidente -->
                            <TextView
                                android:id="@+id/chipHistorialOccidente"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Zona Occidente"
                                android:textColor="@color/krono_chip_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Exportar Zona Seleccionada -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExportZonaHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Export"
                            android:src="@drawable/ic_download"
                            app:tint="@color/krono_navy" />

                        <TextView
                            android:id="@+id/txtTituloExportZona"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Exportar Pedidos de Zona Norte"
                            android:textColor="@color/krono_navy_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Export CSV de Zona -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportZonaCsv"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/krono_navy"
                            android:text="📊 CSV Zona"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_table_chart"
                            app:iconSize="14dp"
                            app:iconTint="@color/white" />

                        <!-- Export PDF de Zona -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportZonaPdf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FAF4ED"
                            android:text="📄 PDF Zona"
                            android:textAllCaps="false"
                            android:textColor="@color/krono_navy_dark"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_picture_as_pdf"
                            app:iconSize="14dp"
                            app:iconTint="@color/krono_navy"
                            app:strokeColor="@color/krono_card_stroke"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: Granjas Registradas en la Zona -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Farm List"
                        android:src="@drawable/ic_farm"
                        app:tint="@color/krono_navy" />

                    <TextView
                        android:id="@+id/txtHeaderGranjasHistorial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Granjas Registradas en Zona Norte"
                        android:textColor="@color/krono_navy_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCountVisiblesHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="3 Granjas"
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Contenedor Dinámico de Granjas de la Zona con opción de exportar y ver pedidos -->
            <LinearLayout
                android:id="@+id/containerGranjasHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- Resumen Operativo (Copia fiel de Zonas y Granjas) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResumenHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/krono_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtResumenZonaHistorial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Resumen Operativo Zona Norte"
                            android:textColor="@color/krono_navy_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCoberturaHistorial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_blue_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="83% Cobertura"
                            android:textColor="@color/krono_navy_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Stat 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cierre_box"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Insumos Listos"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtInsumosCountHistorial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="148 Unidades"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="0dp" />

                        <!-- Stat 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cierre_box"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Estimado"
                                android:textColor="@color/krono_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtTotalMontoHistorial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$12,450 USD"
                                android:textColor="@color/krono_navy_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
