<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_icon_container"
        android:backgroundTint="@color/white"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con Icono y Título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_truck"
                    app:tint="@color/krono_navy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar Granja"
                    android:textColor="@color/krono_navy_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modifique datos operativos, lote y credenciales"
                    android:textColor="@color/krono_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campo Nombre de la Granja -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre de la Granja *"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditNombreGranja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pin_box"
            android:hint="Ej. Finca Santa María"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="@color/krono_navy_dark"
            android:textColorHint="@color/krono_text_muted"
            android:textSize="14sp" />

        <!-- Campo Lote -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Número de Lote (ej: Lote 01) *"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditLoteGranja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pin_box"
            android:hint="Ej. Lote 01, Lote Norte A"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="@color/krono_navy_dark"
            android:textColorHint="@color/krono_text_muted"
            android:textSize="14sp" />

        <!-- Campo Zona Asignada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Zona Asignada *"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/boxEditZonaGranja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pin_box"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvEditZonaGranja"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zona Norte"
                android:textColor="@color/krono_navy_dark"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="@color/krono_text_secondary" />
        </LinearLayout>

        <!-- Campo Clave Operaria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Clave / Código Operario *"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditClaveGranja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pin_box"
            android:hint="Ej. E100"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="14dp"
            android:textColor="@color/krono_navy_dark"
            android:textColorHint="@color/krono_text_muted"
            android:textSize="14sp" />

        <!-- Campo Contraseña de Acceso -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Contraseña de Acceso *"
            android:textColor="@color/krono_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditPassGranja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pin_box"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/krono_navy_dark"
            android:textColorHint="@color/krono_text_muted"
            android:textSize="14sp" />

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Botón Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogGranjaCancelar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancelar"
                android:textColor="@color/krono_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Botón Guardar Cambios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogGranjaGuardar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/krono_navy"
                android:text="Guardar Cambios"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
