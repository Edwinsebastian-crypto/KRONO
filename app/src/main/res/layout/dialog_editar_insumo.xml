<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_icon_container"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header con Icono y Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                app:tint="@color/krono_navy" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar Insumo"
                android:textColor="@color/krono_navy_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifique la información o elimine el producto"
                android:textColor="@color/krono_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Campo Nombre del Producto -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nombre del Producto *"
        android:textColor="@color/krono_navy"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditNombreProducto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pin_box"
        android:hint="Ej. Fertilizante Urea 46%"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/krono_navy_dark"
        android:textColorHint="@color/krono_text_muted"
        android:textSize="14sp" />

    <!-- Campo Cantidad -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cantidad y Presentación *"
        android:textColor="@color/krono_navy"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditCantidad"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pin_box"
        android:hint="Ej. 15 sacos, 8 galones"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/krono_navy_dark"
        android:textColorHint="@color/krono_text_muted"
        android:textSize="14sp" />

    <!-- Botones de Acción (Eliminar a la izquierda, Cancelar y Guardar a la derecha) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Botón Eliminar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogEliminar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Eliminar"
            android:textColor="@color/krono_red_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/krono_red_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Botón Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancelar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancelar"
            android:textColor="@color/krono_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Botón Guardar Cambios -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogGuardar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/krono_navy"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
